{
  "name": "tools-for-canvas",
  "version": "0.1.0",
  "private": true,
  "description": "Fixes for Canvas LMS students: a weekly to-do list, missing work and due dates.",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt -b chrome",
    "dev:firefox": "wxt -b firefox",
    "build": "npm run build:chrome && npm run build:edge && npm run build:firefox",
    "build:chrome": "wxt build -b chrome",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox",
    "build-for-amo": "wxt build -b firefox",
    "zip": "wxt zip -b chrome && wxt zip -b edge && wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:webext": "web-ext lint --source-dir .output/firefox-mv3",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:firefox": "node tests/firefox/smoke.mjs",
    "test:firefox:file-check": "node tests/firefox/file-check.mjs",
    "test:firefox:submission-pages": "node tests/firefox/submission-pages.mjs",
    "test:firefox:assignments-preview": "node tests/firefox/assignments-preview.mjs",
    "test:firefox:announcements": "node tests/firefox/announcements.mjs",
    "test:firefox:people": "node tests/firefox/people.mjs",
    "test:firefox:dashboard-dock": "node tests/firefox/dashboard-dock.mjs",
    "test:gallery": "node tests/gallery/screenshot.mjs",
    "setup:firefox": "bash tests/firefox/install-firefox.sh",
    "check:size": "node scripts/check-size.mjs",
    "check:urls": "node scripts/check-urls.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:fetch": "node scripts/check-fetch.mjs",
    "check:storage": "node scripts/check-storage.mjs",
    "check:file-check": "node scripts/check-file-check.mjs",
    "check": "npm run build && npm run check:size && npm run check:urls && npm run check:manifest && npm run check:fetch && npm run check:storage && npm run check:file-check"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.6",
    "@types/node": "26.6.5",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "msw": "3.0.3",
    "prettier": "3.9.10",
    "selenium-webdriver": "4.51.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "web-ext": "10.8.0",
    "wxt": "0.21.5"
  },
  "dependencies": {
    "pdfjs-dist": "6.5.438",
    "preact": "11.1.0"
  }
}
